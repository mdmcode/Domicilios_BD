        {
          "name": "2.3 POST Crear Solicitud - Caso Exitoso (sp_crear_solicitud)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const html = pm.response ? pm.response.text() : '';",
                  "const errMatches = [...html.matchAll(/class=\"[^\"]*(?:field-error|validation-summary-errors|alert-danger)[^\"]*\"[^>]*>([\\s\\S]*?)<\\/(?:span|div)>/gi)]",
                  "    .map(m => m[1].replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim())",
                  "    .filter(t => t.length > 0);",
                  "const detalleError = errMatches.length ? ' Error del servidor: ' + errMatches.join(' | ') : '';",
                  "pm.test(\"Solicitud creada y redirigida a Details (200 OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(html, detalleError).to.include(\"Detalle de la solicitud\");",
                  "});",
                  "if (html) {",
                  "    const idMatch = html.match(/Solicitud n\\.º\\s*(\\d+)/);",
                  "    if (idMatch) {",
                  "        pm.collectionVariables.set(\"solicitudId\", idMatch[1]);",
                  "    }",
                  "    const tokenMatch = html.match(/name=\"__RequestVerificationToken\"[^>]*value=\"([^\"]+)\"/);",
                  "    if (tokenMatch) {",
                  "        pm.collectionVariables.set(\"antiForgeryToken\", tokenMatch[1]);",
                  "    }",
                  "    if (!pm.variables.get('domiciliarioId')) {",
                  "        const domSel = html.match(/<select[^>]*name=\"id_domiciliario\"[^>]*>([\\s\\S]*?)<\\/select>/i);",
                  "        if (domSel) {",
                  "            const optRegex = /<option[^>]*value=\"([^\"]+)\"/gi;",
                  "            let m;",
                  "            while ((m = optRegex.exec(domSel[1])) !== null) {",
                  "                if (m[1] && m[1].trim() !== '') {",
                  "                    pm.collectionVariables.set('domiciliarioId', m[1].trim());",
                  "                    break;",
                  "                }",
                  "            }",
                  "        }",
                  "    }",
                  "}",
                  "pm.test(\"ID de solicitud y domiciliario disponible capturados\", function () {",
                  "    pm.expect(pm.collectionVariables.get(\"solicitudId\"), detalleError).to.not.be.empty;",
                  "    pm.expect(pm.variables.get(\"domiciliarioId\"), \"No hay domiciliarios disponibles (fn_domiciliario_disponible = 1)\").to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
