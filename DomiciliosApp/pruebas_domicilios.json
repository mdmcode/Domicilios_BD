                  "    const htmlToken = pm.response.text();",
                  "    const match = htmlToken.match(/name=\"__RequestVerificationToken\"[^>]*value=\"([^\"]+)\"/);",
                  "    if (match) {",
                  "        pm.collectionVariables.set(\"antiForgeryToken\", match[1]);",
                  "    }",
                  "}"
                ]
