    {
      "name": "2. Ciclo de Vida de Solicitud (SPs y Triggers)",
      "item": [
        {
          "name": "2.1 GET Formulario Crear Solicitud (Obtener Token e IDs Reales)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Formulario de creación carga correctamente (200 OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.text()).to.include(\"Nueva solicitud\");",
                  "});",
                  "if (pm.response && pm.response.code) {",
                  "    const html = pm.response.text();",
                  "    const match = html.match(/name=\"__RequestVerificationToken\"[^>]*value=\"([^\"]+)\"/);",
                  "    if (match) {",
                  "        pm.collectionVariables.set(\"antiForgeryToken\", match[1]);",
                  "    }",
                  "    function firstOption(selectId) {",
                  "        const selMatch = html.match(new RegExp('<select[^>]*id=\"' + selectId + '\"[^>]*>([\\\\s\\\\S]*?)<\\\\/select>', 'i'));",
                  "        if (!selMatch) return '';",
                  "        const optRegex = /<option[^>]*value=\"([^\"]+)\"/gi;",
                  "        let m;",
                  "        while ((m = optRegex.exec(selMatch[1])) !== null) {",
                  "            if (m[1] && m[1].trim() !== '') return m[1].trim();",
                  "        }",
                  "        return '';",
                  "    }",
                  "    if (!pm.variables.get('metodoPagoId')) {",
                  "        pm.collectionVariables.set('metodoPagoId', firstOption('id_metodoPago') || '1');",
                  "    }",
                  "    if (!pm.variables.get('establecimientoId')) {",
                  "        pm.collectionVariables.set('establecimientoId', firstOption('id_establecimientoRecogida') || '1');",
                  "    }",
                  "    const dirMapMatch = html.match(/window\\.direccionesPorCliente\\s*=\\s*(\\{[\\s\\S]*?\\});/);",
                  "    if (dirMapMatch) {",
                  "        try {",
                  "            const mapa = JSON.parse(dirMapMatch[1]);",
                  "            const curCli = pm.variables.get('clienteId');",
                  "            const curDir = pm.variables.get('direccionEntregaId');",
                  "            const validPair = curCli && mapa[curCli] && mapa[curCli].some(d => String(d.value) === String(curDir));",
                  "            if (!validPair) {",
                  "                const cliKeys = Object.keys(mapa).filter(k => Array.isArray(mapa[k]) && mapa[k].length > 0);",
                  "                if (cliKeys.length > 0) {",
                  "                    pm.collectionVariables.set('clienteId', cliKeys[0]);",
                  "                    pm.collectionVariables.set('direccionEntregaId', String(mapa[cliKeys[0]][0].value));",
                  "                }",
                  "            }",
                  "        } catch (e) {}",
                  "    }",
                  "}",
                  "pm.test(\"AntiForgeryToken e IDs válidos capturados\", function () {",
                  "    pm.expect(pm.collectionVariables.get(\"antiForgeryToken\")).to.not.be.empty;",
                  "    pm.expect(pm.variables.get(\"clienteId\"), \"Debe existir al menos un cliente con dirección registrada en cliente_direccion\").to.not.be.empty;",
                  "    pm.expect(pm.variables.get(\"direccionEntregaId\"), \"Debe existir una dirección de entrega asociada al cliente\").to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/Solicitudes/Create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Solicitudes",
                "Create"
