@model DomiciliosApp.Models.estadosolicitud
@using DomiciliosApp.Models
@using Microsoft.EntityFrameworkCore
@inject DomiciliosContext Db
@{
    ViewData["Title"] = "Detalle de el estado de solicitud";
}

<div class="page-head">
    <div>
        <h1>Detalle de el estado de solicitud</h1>
        <p class="page-sub">Registro n.º @Model.id_estado</p>
    </div>
    <div class="head-actions">
        <a asp-action="Edit" asp-route-id="@Model.id_estado" class="btn btn-primary">Editar</a>
        <a asp-action="Index" class="btn btn-outline-secondary">&larr; Volver al listado</a>
    </div>
</div>

<div class="detail-card">
    <div class="detail-section">
        <h2>Información</h2>
        <div class="detail-grid">
            <div class="detail-item">
                <span class="detail-label">@Html.DisplayNameFor(m => m.id_estado)</span>
                <span class="detail-value">@Model.id_estado</span>
            </div>
            <div class="detail-item span-2">
                <span class="detail-label">@Html.DisplayNameFor(m => m.nombre)</span>
                <span class="detail-value">@Model.nombre.Mostrar()</span>
            </div>
        </div>
    </div>
</div>
