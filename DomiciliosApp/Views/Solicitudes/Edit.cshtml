@model DomiciliosApp.Models.solicitud
@using DomiciliosApp.Models
@using Microsoft.EntityFrameworkCore
@inject DomiciliosContext Db
@{
    ViewData["Title"] = "Editar solicitud";
    var estados = Db.Estados();
    var metodos = Db.Metodos();
    var clientes = Db.Clientes();
    var domiciliarios = Db.Domiciliarios();
    var establecimientos = Db.Establecimientos();
    var direcciones = Db.Direcciones();
    var mapa = Db.DireccionesPorCliente();
    var dirCliente = mapa.TryGetValue(Model?.id_cliente ?? 0, out var dc) ? dc : new List<SelectListItem>();
}

<div class="page-head">
    <div>
        <h1>Editar solicitud</h1>
        <p class="page-sub">Solicitud n.º @Model.id_solicitud</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">&larr; Volver al listado</a>
</div>

<form asp-action="Edit" class="form-card">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <input type="hidden" asp-for="id_solicitud" />

    <div class="form-section">
        <h2>Datos generales</h2>
        <div class="form-grid">
            <div class="field">
                <label asp-for="fechaCreacion" class="form-label required"></label>
                <input asp-for="fechaCreacion" class="form-control" type="date" />
                <span asp-validation-for="fechaCreacion" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="horaCreacion" class="form-label required"></label>
                <input asp-for="horaCreacion" class="form-control" type="time" />
                <span asp-validation-for="horaCreacion" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="montoTotal" class="form-label required"></label>
                <input asp-for="montoTotal" class="form-control" type="number" min="0.01" max="99999999.99" step="0.01" inputmode="decimal" placeholder="0.00" />
                <div class="field-hint">Solo números; use punto para los decimales (ej. 15000.50).</div>
                <span asp-validation-for="montoTotal" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="id_estado" class="form-label required"></label>
                <select asp-for="id_estado" class="form-select" asp-items="estados"><option value="">Seleccione…</option></select>
                <span asp-validation-for="id_estado" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="id_metodoPago" class="form-label required"></label>
                <select asp-for="id_metodoPago" class="form-select" asp-items="metodos"><option value="">Seleccione…</option></select>
                <span asp-validation-for="id_metodoPago" class="field-error"></span>
            </div>
            <div class="field span-2">
                <label asp-for="descripcion" class="form-label"></label>
                <textarea asp-for="descripcion" class="form-control" rows="3" maxlength="500" data-clean></textarea>
                <span asp-validation-for="descripcion" class="field-error"></span>
            </div>
        </div>
    </div>

    <div class="form-section">
        <h2>Cliente y entrega</h2>
        <div class="form-grid">
            <div class="field">
                <label asp-for="id_cliente" class="form-label required"></label>
                <select asp-for="id_cliente" class="form-select searchable" asp-items="clientes"><option value="">Escriba para buscar un cliente…</option></select>
                <div class="field-hint">Busque por nombre o documento.</div>
                <span asp-validation-for="id_cliente" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="id_direccionEntrega" class="form-label required"></label>
                <select asp-for="id_direccionEntrega" class="form-select searchable" asp-items="dirCliente" data-depends-on="id_cliente" data-source="direccionesPorCliente"><option value="">Seleccione…</option></select>
                <div class="field-hint">Solo se listan las direcciones registradas para el cliente elegido.</div>
                <span asp-validation-for="id_direccionEntrega" class="field-error"></span>
            </div>
        </div>
    </div>

    <div class="form-section">
        <h2>Recogida</h2>
        <div class="form-grid">
            <div class="field">
                <label asp-for="id_establecimientoRecogida" class="form-label"></label>
                <select asp-for="id_establecimientoRecogida" class="form-select searchable" asp-items="establecimientos" data-excludes="id_direccionRecogidaExterna"><option value="">Sin establecimiento</option></select>
                <div class="field-hint">Elija un establecimiento o una dirección externa, no ambos.</div>
                <span asp-validation-for="id_establecimientoRecogida" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="id_direccionRecogidaExterna" class="form-label"></label>
                <select asp-for="id_direccionRecogidaExterna" class="form-select searchable" asp-items="direcciones" data-excludes="id_establecimientoRecogida"><option value="">Sin dirección externa</option></select>
                <span asp-validation-for="id_direccionRecogidaExterna" class="field-error"></span>
            </div>
        </div>
    </div>

    <div class="form-section">
        <h2>Asignación</h2>
        <div class="form-grid">
            <div class="field span-2">
                <label asp-for="id_domiciliario" class="form-label"></label>
                <select asp-for="id_domiciliario" class="form-select searchable" asp-items="domiciliarios" data-assign-date="fechaAsignacion" data-assign-time="horaAsignacion"><option value="">Sin asignar</option></select>
                <div class="field-hint">Al elegir un domiciliario se completa la fecha y hora de asignación.</div>
                <span asp-validation-for="id_domiciliario" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="fechaAsignacion" class="form-label"></label>
                <input asp-for="fechaAsignacion" class="form-control" type="date" />
                <span asp-validation-for="fechaAsignacion" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="horaAsignacion" class="form-label"></label>
                <input asp-for="horaAsignacion" class="form-control" type="time" />
                <span asp-validation-for="horaAsignacion" class="field-error"></span>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <a asp-action="Index" class="btn btn-light">Cancelar</a>
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>window.direccionesPorCliente = @Html.Raw(mapa.AJson());</script>
}
