@model IEnumerable<DomiciliosApp.Models.establecimiento>

@{
    ViewData["Title"] = "Listado";
}

<h1>Listado</h1>

<div class="list-toolbar">
    <div class="search-box">
        <label for="busquedaTabla" class="visually-hidden">Buscar</label>
        <input id="busquedaTabla" class="form-control" type="search" placeholder="Buscar en todos los campos..." autocomplete="off" />
    </div>
    <a class="btn btn-primary btn-crear" asp-action="Create"><span aria-hidden="true">+</span> Crear nuevo</a>
</div>
<table class="table table-hover align-middle searchable-table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.codigo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.telefono)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.id_direccionNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.id_tipoEstablecimientoNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.codigo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.telefono)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.id_direccionNavigation.id_direccion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.id_tipoEstablecimientoNavigation.id_tipoEstablecimiento)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.id_establecimiento">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.id_establecimiento">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.id_establecimiento">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>




