@model IEnumerable<DomiciliosApp.Models.incidente>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.descripcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.fecha)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.hora)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.id_solicitudNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.tipoIncidenteNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.descripcion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.fecha)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.hora)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.id_solicitudNavigation.id_solicitud)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.tipoIncidenteNavigation.id_tipoIncidente)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.id_incidente">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.id_incidente">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.id_incidente">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
