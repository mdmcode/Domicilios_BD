@model IEnumerable<DomiciliosApp.Models.incidente>
@using DomiciliosApp.Models
@inject DomiciliosContext Db

@{
    ViewData["Title"] = "Incidentes";
    int? tipoIncidente = ViewBag.TipoIncidente as int?;

    var tipos = Db.TiposIncidente()
        .Select(x => new SelectListItem(x.Text, x.Value, x.Value == tipoIncidente?.ToString()))
        .ToList();
}

<h1>Incidentes</h1>

<div class="list-toolbar">
    <div class="search-box">
        <label for="busquedaTabla" class="visually-hidden">Buscar</label>
        <input id="busquedaTabla" class="form-control" type="search" placeholder="Buscar en todos los campos..." autocomplete="off" />
    </div>
    <a class="btn btn-primary btn-crear" asp-action="Create"><span aria-hidden="true">+</span> Crear nuevo</a>
</div>

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-md-5">
        <label for="tipoIncidente" class="form-label">Tipo de incidente</label>
        <select id="tipoIncidente" name="tipoIncidente" class="form-select searchable" asp-items="tipos" onchange="this.form.submit()">
            <option value="">Todos los tipos</option>
        </select>
    </div>
    @if (tipoIncidente.HasValue)
    {
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar filtro</a>
        </div>
    }
</form>

<div class="table-responsive">
    <table class="table table-hover table-sm align-middle searchable-table" style="font-size: 0.875rem;">
        <thead>
            <tr>
                <th>Tipo de incidente</th>
                <th>Descripción</th>
                <th>Fecha y hora</th>
                <th>Solicitud #</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.tipoIncidenteNavigation?.nombre</td>
                <td>@item.descripcion</td>
                <td>@item.fecha.ToString("dd/MM/yyyy") @item.hora.ToString("HH:mm")</td>
                <td>@item.id_solicitudNavigation?.id_solicitud</td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@item.id_incidente">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.id_incidente">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.id_incidente">Eliminar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>