@model IEnumerable<DomiciliosApp.Models.incidente>

@{
    ViewData["Title"] = "Incidentes";
}

<h1>Incidentes</h1>

<div class="list-toolbar">
    <div class="search-box">
        <label for="busquedaTabla" class="visually-hidden">Buscar</label>
        <input id="busquedaTabla" class="form-control" type="search" placeholder="Buscar en todos los campos..." autocomplete="off" />
    </div>
    <a class="btn btn-primary btn-crear" asp-action="Create"><span aria-hidden="true">+</span> Crear nuevo</a>
</div>

<div class="table-responsive">
    <table class="table table-hover table-sm align-middle searchable-table" style="font-size: 0.875rem;">
        <thead>
            <tr>
                <th>Tipo de incidente</th>
                <th>Descripción</th>
                <th>Fecha y hora</th>
                <th>Solicitud #</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.tipoIncidenteNavigation?.nombre</td>
                <td>@item.descripcion</td>
                <td>@item.fecha.ToString("dd/MM/yyyy") @item.hora.ToString("HH:mm")</td>
                <td>@item.id_solicitudNavigation?.id_solicitud</td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@item.id_incidente">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.id_incidente">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.id_incidente">Eliminar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>