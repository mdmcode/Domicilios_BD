@model DomiciliosApp.Models.cliente_direccion
@using DomiciliosApp.Models
@using Microsoft.EntityFrameworkCore
@inject DomiciliosContext Db
@{
    ViewData["Title"] = "Detalle de la dirección de cliente";
    var clientes = Db.Clientes();
    var direcciones = Db.Direcciones();
}

<div class="page-head">
    <div>
        <h1>Detalle de la dirección de cliente</h1>
        <p class="page-sub">Relación entre un cliente y una dirección</p>
    </div>
    <div class="head-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">&larr; Volver al listado</a>
    </div>
</div>

<div class="detail-card">
    <div class="detail-section">
        <h2>Relación</h2>
        <div class="detail-grid">
            <div class="detail-item span-2">
                <span class="detail-label">@Html.DisplayNameFor(m => m.id_cliente)</span>
                <span class="detail-value">@clientes.Texto(Model.id_cliente)</span>
            </div>
            <div class="detail-item span-2">
                <span class="detail-label">@Html.DisplayNameFor(m => m.id_direccion)</span>
                <span class="detail-value">@direcciones.Texto(Model.id_direccion)</span>
            </div>
        </div>
    </div>
</div>
