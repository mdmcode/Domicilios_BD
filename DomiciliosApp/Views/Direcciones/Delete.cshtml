@model DomiciliosApp.Models.direccion
@using DomiciliosApp.Models
@using Microsoft.EntityFrameworkCore
@inject DomiciliosContext Db
@{
    ViewData["Title"] = "Eliminar dirección";
}

<div class="page-head">
    <div>
        <h1>Eliminar dirección</h1>
        <p class="page-sub">Revise la información antes de confirmar.</p>
    </div>
</div>

<div class="detail-card danger">
    <div class="danger-banner">
        <span aria-hidden="true">&#9888;</span>
        <div>
            <strong>Esta acción no se puede deshacer.</strong>
            Si el registro está relacionado con otros datos, es posible que no se pueda eliminar.
        </div>
    </div>
    <div class="detail-section">
        <h2>Ubicación</h2>
        <div class="detail-grid">
            <div class="detail-item">
                <span class="detail-label">@Html.DisplayNameFor(m => m.id_direccion)</span>
                <span class="detail-value">@Model.id_direccion</span>
            </div>
            <div class="detail-item span-2">
                <span class="detail-label">@Html.DisplayNameFor(m => m.ubicacion)</span>
                <span class="detail-value">@Model.ubicacion.Mostrar()</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">@Html.DisplayNameFor(m => m.barrio)</span>
                <span class="detail-value">@Model.barrio.Mostrar()</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">@Html.DisplayNameFor(m => m.comuna)</span>
                <span class="detail-value">@Model.comuna.Mostrar()</span>
            </div>
            <div class="detail-item span-2">
                <span class="detail-label">@Html.DisplayNameFor(m => m.referencia)</span>
                <span class="detail-value pre">@Model.referencia.Mostrar()</span>
            </div>
        </div>
    </div>
    <form asp-action="Delete" class="form-actions">
        <input type="hidden" asp-for="id_direccion" />
        <a asp-action="Index" class="btn btn-light">Cancelar</a>
        <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    </form>
</div>
