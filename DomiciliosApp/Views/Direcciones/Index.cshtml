@model IEnumerable<DomiciliosApp.Models.direccion>

@{
    ViewData["Title"] = "Direcciones";
}

<h1>Direcciones</h1>

<div class="list-toolbar">
    <div class="search-box">
        <label for="busquedaTabla" class="visually-hidden">Buscar</label>
        <input id="busquedaTabla" class="form-control" type="search" placeholder="Buscar en todos los campos..." autocomplete="off" />
    </div>
    <a class="btn btn-primary btn-crear" asp-action="Create"><span aria-hidden="true">+</span> Crear nuevo</a>
</div>

<div class="table-responsive">
    <table class="table table-hover table-sm align-middle searchable-table" style="font-size: 0.875rem;">
        <thead>
            <tr>
                <th>Dirección</th>
                <th>Barrio</th>
                <th>Comuna</th>
                <th>Pertenece a</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            var clientes = item.cliente_direccions
                .Select(cd => new { Id = cd.id_cliente, Nombre = cd.id_clienteNavigation?.id_clienteNavigation?.nombre_completo })
                .OrderBy(c => c.Nombre)
                .ToList();
            var establecimientos = item.establecimientos
                .OrderBy(e => e.nombre)
                .ToList();
            var externas = item.solicituds.Count;

            <tr>
                <td>@item.ubicacion</td>
                <td>@item.barrio</td>
                <td>@item.comuna</td>
                <td>
                    @if (!clientes.Any() && !establecimientos.Any() && externas == 0)
                    {
                        <span class="badge bg-secondary">Sin asignar</span>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-1">
                            @foreach (var c in clientes)
                            {
                                <div>
                                    <span class="badge bg-primary me-1">Cliente</span>
                                    <a asp-controller="Clientes" asp-action="Details" asp-route-id="@c.Id">@(c.Nombre ?? $"Cliente #{c.Id}")</a>
                                </div>
                            }
                            @foreach (var e in establecimientos)
                            {
                                <div>
                                    <span class="badge bg-success me-1">Establecimiento</span>
                                    <a asp-controller="Establecimientos" asp-action="Details" asp-route-id="@e.id_establecimiento">@(e.nombre ?? $"Establecimiento #{e.id_establecimiento}")</a>
                                </div>
                            }
                            @if (externas > 0)
                            {
                                <div>
                                    <span class="badge bg-warning text-dark me-1">Recogida externa</span>
                                    @(externas == 1 ? "1 solicitud" : $"{externas} solicitudes")
                                </div>
                            }
                        </div>
                    }
                </td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@item.id_direccion">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.id_direccion">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.id_direccion">Eliminar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>